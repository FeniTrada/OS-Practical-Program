echo "Enter how many prime numbers you want:"
read n

count=0
num=2

echo "Prime numbers are:"

while [ $count -lt $n ]
do
    i=2
    flag=0

    while [ $i -lt $num ]
    do
        if [ $((num % i)) -eq 0 ]
        then
            flag=1
            break
        fi
        i=$((i + 1))
    done

    if [ $flag -eq 0 ]
    then
        echo $num
        count=$((count + 1))
    fi

    num=$((num + 1))
done
