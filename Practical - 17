#include <stdio.h>
#include <stdlib.h>
#include <dirent.h>

int main(int argc, char *argv[]) {
    DIR *dir;
    struct dirent *entry;
    char *path;

   
    if (argc == 1) {
        path = ".";
    } else {
        path = argv[1];
    }

  
    dir = opendir(path);
    if (dir == NULL) {
        perror("Unable to open directory");
        return 1;
    }

    
    while ((entry = readdir(dir)) != NULL) {
        printf("%s\n", entry->d_name);
    }

    
    closedir(dir);

    return 0;
}
